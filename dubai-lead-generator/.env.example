# ==============================================================================
# LITSA LEAD GENERATOR — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Application Environment
APP_ENV=production                       # development | staging | production
DEBUG=false
PUBLIC_BASE_URL=https://leads.yourdomain.com
FRONTEND_ORIGIN=https://leads.yourdomain.com
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=generate-a-strong-secret-key-at-least-32-chars

# Admin Security & Authentication
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=                     # Bcrypt hash (or leave blank to use ADMIN_DEFAULT_PASSWORD on first setup)
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately123!
JWT_SECRET=generate-a-cryptographically-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database (PostgreSQL recommended for production; SQLite supported for local development)
DATABASE_URL=postgresql://litsa_user:litsa_password@localhost:5432/litsa_leads
# DATABASE_URL=sqlite:///./dubai_leads.db

# Redis & Celery (Background Job Queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Lead Discovery Providers
SERPAPI_API_KEY=YOUR_SERPAPI_KEY
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN

# AI Services
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Contact Discovery & Verification
APOLLO_API_KEY=YOUR_APOLLO_API_KEY
SNOV_USER_ID=YOUR_SNOV_USER_ID
SNOV_SECRET=YOUR_SNOV_SECRET
TOMBA_API_KEY=YOUR_TOMBA_API_KEY
ZEROBOUNCE_API_KEY=YOUR_ZEROBOUNCE_API_KEY

# Email Outreach (Resend API or SMTP)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM_NAME=Sandesh Barde
EMAIL_FROM_ADDRESS=outreach@yourdomain.com
REPLY_TO=contact@yourdomain.com

# Standard SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_GMAIL_APP_PASSWORD

# Google Sheets Sync (Optional)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# Feature Flags & Quota Protection
FREE_MODE=true
ENABLE_REVIEWS=false
ENABLE_PHOTOS=false
ENABLE_POSTS=false
ENABLE_GEMINI=true
ENABLE_ZEROBOUNCE=true
ENABLE_WEB_VERIFICATION=true
STOP_AT_QUOTA_PERCENT=80.0
PROVIDER_TEST_MODE=false
TEST_RECIPIENT_EMAIL=

# Run Limits
MAX_BUSINESSES_PER_QUERY=20
MAX_TOTAL_BUSINESSES_PER_RUN=100
MAX_WEB_VERIFICATION_CALLS=100
